# .env.example — Copy to .env and fill in your values for local dev.
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev: leave unset to use SQLite (tenderai_dev.db)
# Production (Render): set to Supabase Transaction Mode connection string
#   postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (PDF Storage)
# ---------------------------------------------------------------------------
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>
SUPABASE_BUCKET=tenders

# ---------------------------------------------------------------------------
# Upstash Redis (Celery Broker)
# ---------------------------------------------------------------------------
# Get from: Upstash Console → Redis → Connect → .env tab
# Use the rediss:// (TLS) URL for production, redis:// for local Docker Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Gemini API
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<your key>

# ---------------------------------------------------------------------------
# Job runner
# ---------------------------------------------------------------------------
# Leave unset on Render Free (no worker). Jobs run in a background thread.
# Set to true only when a Celery worker is consuming CELERY_BROKER_URL.
USE_CELERY=false

# Vite / Firebase frontend — public FastAPI origin (no trailing slash)
# VITE_API_BASE_URL=https://tender-ai-9x0r.onrender.com

# ---------------------------------------------------------------------------
# Embedding Model (SentenceTransformers)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
