*.tfstate.backup
.terraform.lock.hcl

# Lambda deployment packages
lambda/*.zip

# Docker
.dockerignore

# Test artifacts & local dev databases
*.log
*.db
eval_results/
.firebase/

# Synthetic tenders & generation corpus
corpus/


