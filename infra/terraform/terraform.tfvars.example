###############################################################################
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your real values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars to version control — add it to .gitignore
###############################################################################

# ---- AWS ----
aws_region   = "us-east-1"
project_name = "tenderai"
environment  = "dev"

# ---- Secrets (required — no defaults) ----
db_password    = "CHANGE_ME_strong_password_123!"
gemini_api_key = "CHANGE_ME_your_gemini_api_key"

# ---- Database ----
db_instance_class = "db.t3.micro"    # Use db.t3.small or larger for prod
db_name           = "tenderai"
db_username       = "tenderai_admin"

# ---- ECS sizing (adjust for load) ----
api_cpu    = 512    # 0.5 vCPU
api_memory = 1024   # 1 GB

worker_cpu    = 1024  # 1 vCPU  (sentence-transformers needs >512MB)
worker_memory = 2048  # 2 GB

api_desired_count    = 1
worker_desired_count = 1

# ---- SQS ----
sqs_message_retention_seconds  = 345600   # 4 days
sqs_visibility_timeout_seconds = 900      # 15 min — must be >= max task runtime
sqs_max_receive_count          = 4        # 4 delivery attempts → DLQ

# ---- S3 ----
s3_force_destroy = true    # Set false in prod — prevents accidental bucket deletion

# ---- Networking ----
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
