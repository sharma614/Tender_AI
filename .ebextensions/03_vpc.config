
option_settings:
  # Place EB in the same VPC as your RDS and SQS resources
  aws:ec2:vpc:
    VPCId: vpc-04540426190056d50
    Subnets: "subnet-0c33d39c5fe7bd5cd,subnet-02b6da0052c0eb421"       # public subnets (API instances)
    ELBSubnets: "subnet-0c33d39c5fe7bd5cd,subnet-02b6da0052c0eb421"    # public subnets (Load Balancer)
    AssociatePublicIpAddress: true

  # Instance settings
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.medium
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role

  # Autoscaling
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 2
